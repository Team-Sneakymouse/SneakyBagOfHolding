# Copy to ~/.gradle/gradle.properties or export as ORG_GRADLE_PROJECT_* env vars.
# Never commit real credentials.

# --- sneakyrp Maven (Reposilite) ---
# https://maven.sneakyrp.com/releases
# sneakyrpUsername is the token name; sneakyrpPassword is the generated secret.
sneakyrpUsername=YOUR_UPLOAD_USERNAME
sneakyrpPassword=YOUR_UPLOAD_TOKEN
